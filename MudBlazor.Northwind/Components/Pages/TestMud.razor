@page "/testmud"
@using System.Reflection
@using Microsoft.Kiota.Abstractions.Authentication
@using Microsoft.Kiota.Http.HttpClientLibrary
@using global::Northwind.Odata.Api.Client
@using global::Northwind.Odata.Api.Client.Models
@using global::Northwind.Odata.Api.Client.Odata.Employees
<h3>TestMud</h3>

    
<MudPaper Class="pa-4" Elevation="4">
        <MudForm @ref="form" Model="@employee">
        <MudTextField @bind-Value="employee.FirstName" Label="First Name" Required="true" />
        <MudTextField @bind-Value="employee.LastName" Label="Last Name" Required="true" />
        <MudTextField @bind-Value="employee.Title" Label="Title" />
        <MudTextField @bind-Value="employee.TitleOfCourtesy" Label="Courtesy Title" />
@*         <MudDatePicker @bind-Date="Convert.ToDateTime(employee.BirthDate)" Label="Birth Date" />
        <MudDatePicker @bind-Date="Convert.ToDateTime(employee.HireDate)" Label="Hire Date" /> *@
        <MudTextField @bind-Value="employee.Address" Label="Address" />
        <MudTextField @bind-Value="employee.City" Label="City" />
        <MudTextField @bind-Value="employee.Region" Label="Region" />
        <MudTextField @bind-Value="employee.PostalCode" Label="Postal Code" />
        <MudTextField @bind-Value="employee.Country" Label="Country" />
        <MudTextField @bind-Value="employee.HomePhone" Label="Home Phone" />
        <MudTextField @bind-Value="employee.Extension" Label="Extension" />
        <MudTextField @bind-Value="employee.Notes" Label="Notes" TextArea="true" />
        <MudTextField @bind-Value="employee.PhotoPath" Label="Photo Path" />

            <MudButton OnClick="SubmitForm">Submit</MudButton>
    </MudForm>
    </MudPaper>
    @if (success)
    {
        <MudAlert Severity="Severity.Success">Form submitted successfully!</MudAlert>
    }
   

