@page "/employeeeditformgen"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inject KiotaRequestBuilder kiotaRequestBuilder
@using MudBlazor.Northwind.Mappers.Employee
@using MudBlazor.Northwind.Services
@using MudBlazor.Extensions
@using MudBlazor.Extensions.Options
@inject NavigationManager NavigationManager
@using MudBlazor.Northwind.ViewModels

@* Auto-generated MudBlazor form for MudBlazor.Northwind.ViewModels.EmployeeViewModel *@

<EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudCard Class="pa-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" Label="Employee Id" @bind-Value="Model.EmployeeId" />
                    <ValidationMessage For="@(() => Model.EmployeeId)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Date Created" @bind-Value="Model.CreationDate" />
                    <ValidationMessage For="@(() => Model.CreationDate)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Last Name" @bind-Value="Model.LastName" />
                    <ValidationMessage For="@(() => Model.LastName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="First Name" @bind-Value="Model.FirstName" />
                    <ValidationMessage For="@(() => Model.FirstName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Title" @bind-Value="Model.Title" />
                    <ValidationMessage For="@(() => Model.Title)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="PassWord" @bind-Value="Model.Password" InputType="InputType.Password" />
                    <ValidationMessage For="@(() => Model.Password)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Title Of Courtesy" @bind-Value="Model.TitleOfCourtesy" />
                    <ValidationMessage For="@(() => Model.TitleOfCourtesy)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Birth Date"
                                   @bind-Date="Model.BirthDate"
                                   PickerVariant="PickerVariant.Dialog" Clearable="true" />
                    <ValidationMessage For="@(() => Model.BirthDate)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Hire Date"
                                   @bind-Date="Model.HireDate"
                                   PickerVariant="PickerVariant.Dialog" Clearable="true" />
                    <ValidationMessage For="@(() => Model.HireDate)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Address" @bind-Value="Model.Address" />
                    <ValidationMessage For="@(() => Model.Address)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="City" @bind-Value="Model.City" />
                    <ValidationMessage For="@(() => Model.City)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Region" @bind-Value="Model.Region" />
                    <ValidationMessage For="@(() => Model.Region)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Postal Code" @bind-Value="Model.PostalCode" />
                    <ValidationMessage For="@(() => Model.PostalCode)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Country" @bind-Value="Model.Country" />
                    <ValidationMessage For="@(() => Model.Country)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Home Phone" @bind-Value="Model.HomePhone" />
                    <ValidationMessage For="@(() => Model.HomePhone)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Extension" @bind-Value="Model.Extension" />
                    <ValidationMessage For="@(() => Model.Extension)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Photo" @bind-Value="Model.Photo" />
                    <ValidationMessage For="@(() => Model.Photo)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Notes" @bind-Value="Model.Notes" />
                    <ValidationMessage For="@(() => Model.Notes)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Photo Path" @bind-Value="Model.PhotoPath" />
                    <ValidationMessage For="@(() => Model.PhotoPath)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudExSelect T="MudBlazor.Northwind.ViewModels.OrderViewModel" Label="Orders for Employee"
                                 ItemCollection="@_OrdersItems"
                                 SelectedValues="@Model.Orders"
                                 MultiSelection="true"
                                 SelectAll="true"
                                 SearchBox="true"
                                 Color="Color.Primary">
                    </MudExSelect>
                    <ValidationMessage For="@(() => Model.Orders)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudExSelect T="MudBlazor.Northwind.ViewModels.EmployeeViewModel" Label="Reports To"
                                 ItemCollection="@_ReportsToItems"
                                 Value="@Model.ReportsTo"
                                 ValueChanged="@((MudBlazor.Northwind.ViewModels.EmployeeViewModel v) => Model.ReportsTo = v)"
                                 MultiSelection="false"
                                 SearchBox="true"
                                 Color="Color.Primary">
                    </MudExSelect>
                    <ValidationMessage For="@(() => Model.ReportsTo)" />
                </MudItem>
            </MudGrid>
        </MudCardContent>

        <MudCardActions Class="justify-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Save</MudButton>
        </MudCardActions>
    </MudCard>

</EditForm>

@code {
    [Parameter] public MudBlazor.Northwind.ViewModels.EmployeeViewModel Model { get; set; } = new MudBlazor.Northwind.ViewModels.EmployeeViewModel();

    private List<MudBlazor.Northwind.ViewModels.OrderViewModel> _OrdersItems = new List<MudBlazor.Northwind.ViewModels.OrderViewModel>();
    private List<MudBlazor.Northwind.ViewModels.EmployeeViewModel> _ReportsToItems = new List<MudBlazor.Northwind.ViewModels.EmployeeViewModel>();

    protected override async Task OnInitializedAsync()
    {
        // TODO: populate _OrdersItems (List<MudBlazor.Northwind.ViewModels.OrderViewModel>) from API or service
        // e.g. _OrdersItems = await KiotaRequestBuilder.GetMudBlazor.Northwind.ViewModels.OrderViewModelList(...);
        // Example: populate _ReportsToItems using custom query "employees?$filter=Id ne {Id}"
        // _ReportsToItems = await KiotaRequestBuilder.SomeMethodThatReturnsMudBlazor.Northwind.ViewModels.EmployeeViewModelList("employees?$filter=Id ne {Id}");
    }

    private async Task HandleValidSubmit()
    {
        // TODO: handle save, Model passes DataAnnotations validation
        await Task.CompletedTask;
    }

    private void Cancel() => NavigationManager.NavigateTo("/");
}
