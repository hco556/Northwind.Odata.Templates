@page "/mud-ex-select"


    <MudText Class="mb-5" Typo="Typo.subtitle1">Use can use grouping directly for your binded itemscollection just set the GroupBy function and enable grouping. In this demo its grouped by state if you set GroupingEnabled to true </MudText>

@if (_states is null)
{ <MudText>Loading...</MudText> }
else
{

<MudGrid>
    <MudItem xs="12" sm="8" Class="d-flex align-start justify-center">
        <MudSelectExtended T="string" Label="Groups & Items" AnchorOrigin="Origin.BottomCenter" @bind-Value="_selectedValue" @bind-SelectedValues="_selectedValues" MultiSelection="_multiselection">
            <MudSelectItemGroupExtended T="string" Text="Group 1" Sticky="_sticky" Nested="_nested" InitiallyExpanded="_initiallyExpanded">
                <MudSelectItemExtended Value="@("Item 1")" />
                <MudSelectItemExtended Value="@("Item 2")" />
                <MudSelectItemExtended Value="@("Item 3")" />
            </MudSelectItemGroupExtended>

                <MudSelectItemGroupExtended T="string" Text="Group 2" Sticky="_sticky" Nested="_nested" InitiallyExpanded="_initiallyExpanded">
                    <MudSelectItemExtended Value="@("Item 4")" />
                    <MudSelectItemExtended Value="@("Item 5")" />
                    <MudSelectItemExtended Value="@("Item 6")" />
                </MudSelectItemGroupExtended>

                <MudSelectItemGroupExtended T="string" Text="Group 3" Sticky="_sticky" Nested="_nested" InitiallyExpanded="_initiallyExpanded">
                    <MudSelectItemExtended Value="@("Item 7")" />
                    <MudSelectItemExtended Value="@("Item 8")" />
                    <MudSelectItemExtended Value="@("Item 9")" />
                </MudSelectItemGroupExtended>
            </MudSelectExtended>

        </MudItem>

        <MudItem xs="12" sm="4">
            <MudCheckBox @bind-Value="_multiselection" Label="MultiSelection" Color="Color.Primary" />
            <MudCheckBox @bind-Value="_sticky" Label="Sticky" Color="Color.Primary" />
            <MudCheckBox @bind-Value="_nested" Label="Nested" Color="Color.Primary" />
            <MudCheckBox @bind-Value="_initiallyExpanded" Label="Initially Expanded" Color="Color.Primary" />
            <MudDivider />
            <MudText Class="ma-4">Selected Value: @_selectedValue</MudText>
            <MudText Class="ma-4">Selected Values: @(_selectedValues == null ? null : string.Join(", ", _selectedValues))</MudText>
        </MudItem>
    </MudGrid>



<MudGrid>
    <MudItem xs="12" sm="8" Class="d-flex gap-4">
        <MudSelectExtended MultiSelection="@_multiselection" ItemCollection="_states" SelectedValues="_selectedStates1" SearchBox="true" SearchBoxAutoFocus="@_searchBoxAutoFocus" T="string" Label="Standard Search" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" HelperText="Search with 'Contains' logic" SearchBoxClearable="_searchBoxClearable" Clearable="true"/>
        <MudSelectExtended MultiSelection="@_multiselection" ItemCollection="_states" SearchBox="true" SearchBoxAutoFocus="@_searchBoxAutoFocus" SearchFunc="@(new Func<string, string, bool>(SearchItems))" T="string" Label="Custom Search Func" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" SearchBoxPlaceholder="Some Placeholder" HelperText="Search with 'StartsWith' logic" SearchBoxClearable="_searchBoxClearable" Clearable="true" />
    </MudItem>

        <MudItem xs="12" sm="4">
            <MudStack>
                <MudSwitchM3 @bind-Value="_multiselection" Color="Color.Primary" Label="MultiSelection" />
                <MudSwitchM3 @bind-Value="_searchBoxAutoFocus" Color="Color.Primary" Label="AutoFocus (SearchBox)" />
                <MudSwitchM3 @bind-Value="_searchBoxClearable" Color="Color.Primary" Label="Clearable (SearchBox)" />
            </MudStack>
        </MudItem>
    </MudGrid>

@code {

@* 
                    <MudSelectExtended 
                                 Variant="Variant.Text"
                                 @bind-SelectedValues="@_selected"
                                 MultiSelection="true"
                                 SelectAll="true"
                                 ToStringFunc="@(x => x== null? String.Empty: x.Name + " - " + x.PostalCode)"
                                 ItemCollection="_samples" SearchBox="true" T="City" Label="Cities you want to live" AnchorOrigin="Origin.BottomCenter">
                        <ItemTemplate>
                            <MudAlert>@context?.Name</MudAlert>
                        </ItemTemplate> 
                    </MudSelectExtended>*@
}


